# Copy to .env.local and fill in. Never commit real values.
# Local values: `npx supabase status -o env` (API_URL, PUBLISHABLE_KEY, SECRET_KEY).

# --- Public (shipped to the browser; access is enforced by RLS) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only: NEVER prefix with NEXT_PUBLIC_ ---
# Supabase secret key (bypasses RLS). Used only for platform-admin actions and
# the notification sender, from modules that import "server-only".
SUPABASE_SECRET_KEY=

# Optional: redirect "/" to this farm (single-farm deployment, D-42).
DEFAULT_TENANT_SLUG=

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# Email notifications (Phase 6).
RESEND_API_KEY=
EMAIL_FROM="Farm Orders <orders@example.com>"
